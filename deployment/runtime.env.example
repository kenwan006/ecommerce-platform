# Copy to runtime.env on the EC2 host. Do not commit the copy.
# Shared application values
DB_USERNAME=replace-with-a-least-privilege-mysql-user
DB_PASSWORD=replace-with-that-users-password
POSTGRES_USER=sunridge_agent
POSTGRES_PASSWORD=replace-with-postgres-password
JWT_SECRET=replace-with-a-long-random-value
INTERNAL_API_KEY=replace-with-a-long-random-value

# External provider values
OPENAI_API_KEY=replace-with-openai-key
GITHUB_TOKEN=replace-with-github-token
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-signing-secret
STRIPE_PUBLISHABLE_KEY=replace-with-stripe-publishable-key

# Application settings
APP_FRONTEND_URL=http://replace-with-your-domain
NOTIFICATION_FROM=orders@replace-with-your-domain
MAIL_HOST=replace-with-smtp-host
MAIL_PORT=587
